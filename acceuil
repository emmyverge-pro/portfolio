<style>
:root{--beige:#F4E8CE;--beige2:#E9D9B3;--orange:#EC8042;--rose:#ED4A73;--blue:#58DBCE;--ink:#240115;
--sans:'Bricolage Grotesque','Helvetica Neue',Arial,sans-serif;--serif:'Newsreader',Georgia,serif}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{background:var(--beige);color:var(--ink);font-family:var(--serif);font-size:1.15rem;line-height:1.65}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
header{position:sticky;top:0;z-index:5;background:var(--beige);border-bottom:2px solid var(--ink);display:flex;align-items:center;justify-content:space-between;gap:.75rem 1.5rem;flex-wrap:wrap;padding:.8rem clamp(1rem,4vw,3rem)}
.logo{font:800 1.4rem var(--sans);text-decoration:none;letter-spacing:-.02em}
nav{display:flex;gap:.4rem;flex-wrap:wrap}
nav a{font:700 .95rem var(--sans);text-decoration:none;padding:.4rem .9rem;border-radius:99px;border:2px solid transparent}
nav a:hover{border-color:var(--ink)}
nav a[aria-current=page]{background:var(--ink);color:var(--beige)}
.lang{display:flex;align-items:center;gap:.5rem;font:700 .9rem var(--sans)}
.lang button{all:unset;cursor:pointer;width:46px;height:26px;border-radius:99px;background:var(--blue);border:2px solid var(--ink);position:relative;box-sizing:border-box}
.lang button:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.lang button::after{content:"";position:absolute;top:1px;left:1px;width:20px;height:20px;border-radius:50%;background:var(--ink);transition:transform .2s}
.lang button[aria-checked=true]::after{transform:translateX(20px)}
main{max-width:1100px;margin:0 auto;padding:0 clamp(1rem,4vw,3rem) 4rem}
.view{display:none}.view.on{display:block}
h1,h2,h3{font-family:var(--sans);line-height:1.05;letter-spacing:-.03em}
.hero{padding:clamp(2.5rem,8vw,6rem) 0 2rem;display:grid;gap:2rem}
.hero h1{font-size:clamp(3rem,13vw,9rem);font-weight:800;color:var(--ink)}
.hero p{max-width:34ch;font-size:clamp(1.25rem,3vw,1.7rem);line-height:1.35}
.frame{background:var(--blue);padding:clamp(.5rem,1.5vw,1rem);border-radius:2rem 2rem 2rem 8rem;box-shadow:12px 12px 0 var(--rose)}
.frame .v{position:relative;aspect-ratio:16/9;border-radius:1.4rem 1.4rem 1.4rem 7rem;overflow:hidden;background:#000}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.cap{margin-top:1.4rem;font-size:1rem;opacity:.8}
h2{font-size:clamp(2rem,6vw,3.4rem);margin:4rem 0 1.2rem}
.row{display:grid;grid-template-columns:1fr;gap:.2rem;padding:1.3rem 0;border-top:2px solid var(--ink);text-decoration:none}
.row:last-child{border-bottom:2px solid var(--ink)}
.row h3{font-size:1.6rem}
.row span{font-size:1.05rem;max-width:60ch}
.row:hover h3{color:var(--orange)}
.row:nth-child(3n+2):hover h3{color:var(--blue)}
.row:nth-child(3n):hover h3{color:#C9506A}
@media(min-width:760px){.row{grid-template-columns:1fr 1fr;gap:2rem;align-items:baseline}.hero{grid-template-columns:1fr}}
.about{display:grid;gap:2rem;padding-top:3rem}
.about .blk{background:var(--rose);padding:1.5rem;border-radius:1.5rem;font-size:1.1rem}
.about .b2{background:var(--blue)}.about .b3{background:var(--orange)}
.about h1{font-size:clamp(2.5rem,9vw,5rem)}
@media(min-width:760px){.about{grid-template-columns:1.2fr 1fr}.about h1,.about .wide{grid-column:1/-1}}
.lock{max-width:440px;margin:4rem auto;background:var(--beige2);border:2px solid var(--ink);padding:2rem;border-radius:1.5rem}
.lock h1{font-size:2rem;margin-bottom:.5rem}
.lock input{font:700 1.5rem var(--sans);letter-spacing:.4em;width:100%;padding:.6rem 1rem;margin:1rem 0;border:2px solid var(--ink);border-radius:.8rem;background:var(--beige)}
.btn{font:700 1rem var(--sans);background:var(--orange);color:var(--ink);border:0;padding:.8rem 1.5rem;border-radius:99px;cursor:pointer}
.btn:hover{background:var(--ink);color:var(--beige)}
.err{color:#B3261E;font:700 .95rem var(--sans);min-height:1.4em}
.res{padding-top:3rem}
.res>h1{font-size:clamp(2.2rem,8vw,4.5rem);color:var(--rose);margin-bottom:.5rem}
details{border-top:2px solid var(--ink);padding:1rem 0}
details:last-child{border-bottom:2px solid var(--ink)}
summary{font:700 1.4rem var(--sans);cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem}
summary::after{content:"+";color:var(--orange);font-size:1.8rem;line-height:1}
details[open] summary::after{content:"–"}
summary::-webkit-details-marker{display:none}
.body{display:grid;gap:1rem;padding-top:1rem}
.body h4{font:700 1rem var(--sans)}
.ac{font:700 .9rem var(--sans);background:var(--rose);display:inline-block;padding:.3rem .8rem;border-radius:99px}
footer{text-align:center;padding:3rem 1rem 2rem;font-size:.95rem;border-top:2px solid var(--ink)}
.contact{margin-bottom:2.5rem}
.contact h2{font-size:clamp(2rem,6vw,3.4rem);margin:0 0 1.2rem}
#clinks{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center}
#clinks a{font:700 1.05rem var(--sans);padding:.7rem 1.3rem;border-radius:99px;text-decoration:none;background:var(--rose);border:2px solid var(--ink)}
#clinks a:nth-child(3n+2){background:var(--blue)}#clinks a:nth-child(3n){background:var(--orange)}
#clinks a:hover{background:var(--ink);color:var(--beige)}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

.hero{position:relative;overflow:hidden}
.hero>*{position:relative;z-index:1}
.shape{position:absolute;z-index:0!important;pointer-events:none}
.s1{width:clamp(110px,22vw,260px);aspect-ratio:1;background:var(--rose);border-radius:50%;right:2%;top:8%}
.s2{width:clamp(90px,16vw,190px);height:clamp(45px,8vw,95px);background:var(--blue);border-radius:200px 200px 0 0;right:22%;top:48%;transform:rotate(-18deg)}
.s3{width:clamp(70px,12vw,140px);aspect-ratio:1;background:var(--orange);border-radius:50% 0 50% 50%;right:8%;top:62%;transform:rotate(20deg)}
.s4{width:clamp(120px,18vw,220px);right:34%;top:4%;color:var(--blue)}
.arc{display:flex;gap:1.5rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:3rem calc(50% - 150px) 9rem;margin:0 calc(-1*clamp(1rem,4vw,3rem));scrollbar-width:none;cursor:grab}
.arc::-webkit-scrollbar{display:none}
.arc.drag{cursor:grabbing;scroll-snap-type:none}
.card{flex:0 0 300px;height:400px;scroll-snap-align:center;display:flex;flex-direction:column;justify-content:flex-end;gap:.6rem;padding:1.6rem;text-decoration:none;position:relative;overflow:hidden;will-change:transform;user-select:none;-webkit-user-drag:none}
.card::before{content:"";position:absolute;opacity:.9}
.card h3{font-size:1.7rem;position:relative}
.card span{font-size:1rem;line-height:1.4;position:relative}
.c0{background:var(--orange);color:var(--ink);border-radius:150px 150px 28px 28px}
.c0::before{width:150px;aspect-ratio:1;border-radius:50%;background:var(--rose);top:60px;left:30px}
.c1{background:var(--rose);border-radius:28px 150px 28px 28px}
.c1::before{width:170px;height:85px;background:var(--blue);border-radius:200px 200px 0 0;top:70px;right:20px;transform:rotate(14deg)}
.c2{background:var(--blue);color:var(--ink);border-radius:28px 28px 150px 28px}
.c2::before{width:140px;aspect-ratio:1;background:var(--orange);border-radius:50% 0 50% 50%;top:50px;left:60px;transform:rotate(-20deg)}
.c3{background:var(--beige2);border:2px solid var(--ink);border-radius:28px}
.c3::before{width:150px;aspect-ratio:1;background:var(--blue);border-radius:50%;top:50px;right:30px;box-shadow:-70px 60px 0 -30px var(--rose)}
.nav2{display:flex;gap:.6rem;justify-content:center;margin-top:-6rem;position:relative}
.nav2 button{font:800 1.4rem var(--sans);width:52px;height:52px;border-radius:50%;border:2px solid var(--ink);background:var(--beige);cursor:pointer}
.nav2 button:hover{background:var(--ink);color:var(--beige)}
@media(max-width:560px){.card{flex-basis:260px;height:380px}.arc{padding-inline:calc(50% - 130px)}}

.facts{display:grid;gap:1rem;margin:1rem 0 2.5rem}
@media(min-width:760px){.facts{grid-template-columns:repeat(3,1fr)}}
.f{padding:1.2rem 1.4rem;border-radius:1.4rem;display:flex;flex-direction:column;gap:.2rem}
.f b{font:700 .95rem var(--sans);opacity:.85}
.f span{font:800 1.5rem/1.15 var(--sans);letter-spacing:-.02em}
.f1{background:var(--rose)}.f2{background:var(--blue);color:var(--ink)}.f3{background:var(--orange);color:var(--ink)}
.skills{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.skills .card{flex:none;height:380px;transform:none;user-select:auto}

.sk{padding-top:3rem}
.sk h1{font-size:clamp(2.4rem,9vw,5rem);margin:1rem 0}
.sk>p{max-width:46ch;font-size:1.3rem}
.back{font:700 1rem var(--sans)}
.works{display:grid;gap:1.5rem;margin-top:2.5rem}
.work{border-top:2px solid var(--ink);padding:1.2rem 0;display:grid;gap:.6rem}
.work h3{font-size:1.6rem}
.work .frame{margin:1rem 0 1.5rem}
.aclist{list-style:none;padding:0;display:grid;gap:.7rem;margin-top:.4rem}
.aclist li{display:grid;grid-template-columns:auto 1fr;gap:.2rem .8rem;align-items:start;font-size:1.05rem;line-height:1.45}
.aclist .ac{white-space:nowrap}
@media(max-width:560px){.aclist li{grid-template-columns:1fr}.aclist .ac{justify-self:start}}
.pdfl{display:inline-block;margin-left:.6rem;font:700 .9rem var(--sans);background:var(--blue);padding:.2rem .8rem;border-radius:99px;text-decoration:none}
.hero{min-height:clamp(240px,38vw,400px);align-content:center}
.about h2{margin:1.5rem 0 0}
.about .frame{margin:0}.about .facts{margin:0}
.about .cap{margin:0}
.mini-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.mini{padding:1.3rem 1.5rem;border-radius:1.4rem;display:flex;flex-direction:column;gap:.3rem}
.mini b{font:800 1.25rem/1.2 var(--sans);letter-spacing:-.01em}
.mini span{font-size:1.05rem}
.m1{background:var(--rose)}.m2{background:var(--blue)}.m3{background:var(--orange)}
.sk h2{margin:3rem 0 1.2rem}
.gallery{columns:260px;column-gap:1.2rem}
.shot{break-inside:avoid;margin:0 0 1.2rem;border-radius:1.2rem;overflow:hidden;background:var(--beige2);border:2px solid var(--ink)}
.shot img{display:block;width:100%;height:auto}
.shot figcaption{padding:.7rem 1rem;font:700 .95rem var(--sans)}
</style>
